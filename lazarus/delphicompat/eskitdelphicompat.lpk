<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <Name Value="ESKitDelphiCompat"/>
    <Type Value="RunTimeOnly"/>
    <Author Value="ESKit"/>
    <CompilerOptions>
      <Version Value="11"/>
      <SearchPaths>
        <UnitOutputDirectory Value="lib/$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
    </CompilerOptions>
    <Description Value="ESKit: units com os nomes do Delphi (Vcl.Forms, Vcl.StdCtrls, System.SysUtils, Winapi.Windows, Data.DB...) que reexportam a LCL e o FPC, para compilar código Delphi sem trocar os uses. Geradas por tools/genvclcompat.py."/>
    <License Value="Modified LGPL"/>
    <Version Major="1"/>
    <Files>
      <Item>
        <Filename Value="data.db.pas"/>
        <UnitName Value="Data.DB"/>
      </Item>
      <Item>
        <Filename Value="system.classes.pas"/>
        <UnitName Value="System.Classes"/>
      </Item>
      <Item>
        <Filename Value="system.contnrs.pas"/>
